
# --- Add this block to your existing .htaccess in public_html ---
# Block the fake-iPhone scraper cluster seen hitting /cheatsheets/
# (identical old iOS 13.2.3 UA string, hitting from many different
# Tencent Cloud IPs in one hour -- real iPhones don't behave that way)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} "^Mozilla/5\.0 \(iPhone; CPU iPhone OS 13_2_3 like Mac OS X\) AppleWebKit/605\.1\.15 \(KHTML, like Gecko\) Version/13\.0\.3 Mobile/15E148 Safari/604\.1$" [NC]
RewriteRule .* - [F,L]
</IfModule>
